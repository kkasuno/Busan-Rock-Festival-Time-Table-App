rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the existing project's policy, excluding this app's new namespace.
    match /{root}/{document=**} {
      allow read, write: if root != 'busanRock2026PickCounts'
        && request.time < timestamp.date(2026, 12, 31);
    }
    function validShow(id) {
      return (id.matches('2026-day[123]-(samrock|green|river|wave|hidden)-[1-7]')
        && id != '2026-day1-green-5') || id == '2026-day1-green-xdinary-heroes';
    }
    function oldCount(id) {
      let path = /databases/$(database)/documents/busanRock2026PickCounts/$(id);
      return exists(path) ? get(path).data.count : 0;
    }
    function resultingCount(id, delta) {
      let next = oldCount(id) + delta;
      return next < 0 ? 0 : next;
    }
    match /busanRock2026PickCounts/{id} {
      allow read: if true;
      allow create, update: if request.auth != null && validShow(id)
        && request.resource.data.keys().hasOnly(['count', 'lastOperationId'])
        && request.resource.data.count is int && request.resource.data.count >= 0
        && request.resource.data.lastOperationId is string
        && request.resource.data.lastOperationId.matches('[a-f0-9]{32}')
        && validChange(id, request.resource.data.lastOperationId);
      function validChange(id, op) {
        let path = /databases/$(database)/documents/busanRock2026PickCounts/$(id)/operations/$(op);
        let receipt = getAfter(path).data;
        return !exists(path) && receipt.delta in [-1, 1]
          && request.resource.data.count == resultingCount(id, receipt.delta);
      }
      match /operations/{op} {
        allow get: if request.auth != null;
        allow create: if request.auth != null && validShow(id)
          && op.matches('[a-f0-9]{32}')
          && request.resource.data.keys().hasOnly(['delta'])
          && request.resource.data.delta in [-1, 1]
          && getAfter(/databases/$(database)/documents/busanRock2026PickCounts/$(id)).data.lastOperationId == op
          && getAfter(/databases/$(database)/documents/busanRock2026PickCounts/$(id)).data.count == resultingCount(id, request.resource.data.delta);
      }
    }
  }
}
